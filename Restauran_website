    grid-template-columns:1fr 1fr;
    gap:70px;
    align-items:center;
}

.about-image{
    height:500px;
    background:
    url("https://images.unsplash.com/photo-1414235077428-338989a2e8c0")
    center/cover;
}

.about-text span{
    color:#8b4a2f;
    letter-spacing:3px;
    font-size:12px;
    font-weight:bold;
}

.about-text h2{
    font-family:Georgia,serif;
    font-size:45px;
    margin:15px 0 25px;
}

.about-text p{
    color:#666;
    line-height:1.9;
    margin-bottom:18px;
}

.stats{
    display:flex;
    gap:45px;
    margin-top:35px;
}

.stats h3{
    font-family:Georgia,serif;
    font-size:30px;
    color:#8b4a2f;
}

.stats p{
