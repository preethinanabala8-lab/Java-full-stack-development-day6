    border-bottom:1px solid #ddd5ca;
}

.nav-container{
    max-width:1200px;
    margin:auto;
    height:78px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:0 25px;
}

.logo{
    font-family:Georgia,serif;
    font-size:30px;
    font-weight:bold;
    color:#8b4a2f;
}

.logo small{
    display:block;
    font-family:Arial;
    font-size:8px;
    letter-spacing:4px;
    color:#777;
    margin-top:-5px;
}

.nav-links{
    display:flex;
    gap:30px;
    list-style:none;
}

.nav-links a{
    text-decoration:none;
    color:#333;
    font-size:14px;
    transition:.3s;
}

.nav-links a:hover{
    color:#8b4a2f;
}

.book-btn{
    text-decoration:none;
    background:#8b4a2f;
    color:white;
    padding:12px 22px;
    border-radius:3px;
}

/* ================= HERO ================= */

.hero{
    min-height:100vh;
    padding-top:78px;
    display:grid;
    grid-template-columns:1fr 1fr;
}

.hero-content{
    display:flex;
    flex-direction:column;
    justify-content:center;
    padding:70px 8%;
}

.hero-label{
    color:#8b4a2f;
    letter-spacing:4px;
    font-size:13px;
    font-weight:bold;
}

.hero h1{
    font-family:Georgia,serif;
    font-size:clamp(50px,6vw,82px);
    line-height:1.05;
    margin:22px 0;
}

.hero h1 span{
    color:#8b4a2f;
    font-style:italic;
}

.hero p{
    max-width:500px;
    color:#666;
    line-height:1.8;
    font-size:16px;
}

.hero-buttons{
    margin-top:32px;
    display:flex;
    gap:15px;
}

.primary{
    background:#8b4a2f;
    color:white;
    padding:15px 27px;
    text-decoration:none;
}

.secondary{
    border:1px solid #8b4a2f;
    color:#8b4a2f;
    padding:15px 27px;
    text-decoration:none;
}

.hero-image{
    background:
    linear-gradient(rgba(0,0,0,.15),rgba(0,0,0,.2)),
    url("https://images.unsplash.com/photo-1517248135467-4c7edcad34c4")
    center/cover;
}

/* ================= COMMON ================= */

.section{
    padding:100px 25px;
}

.container{
    max-width:1150px;
    margin:auto;
}

.section-heading{
    text-align:center;
    margin-bottom:55px;
}

.section-heading span{
